# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored; only this example file is checked in.

# --- Database ---
# EXPENSE_PRO_DATABASE_PASSWORD=
# MY_APP_DATABASE_URL=

# --- Active Record encryption (required — stores DhanCredential secrets at rest) ---
# Generate with: ruby -rsecurerandom -e '3.times { puts SecureRandom.alphanumeric(32) }'
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# --- DhanHQ trading integration ---
# Each user configures their own client_id / token service / fallback token from
# the Dhan Settings page in the UI (stored encrypted in dhan_credentials).
# These ENV vars are only used as a fallback when a user hasn't configured one yet.
DHAN_CLIENT_ID=

# Static fallback access token, used only if the render token endpoint is unreachable.
DHAN_ACCESS_TOKEN=

# Render-deployed algo_trading_api's token endpoint (Auth::DhanController#token).
# Defaults to https://algo-trading-api.onrender.com/auth/dhan/token if unset.
DHAN_TOKEN_SERVICE_URL=

# Bearer secret expected by that endpoint (matches algo_trading_api's DHAN_TOKEN_ACCESS_TOKEN).
DHAN_TOKEN_ACCESS_TOKEN=

# --- Ollama AI Configuration ---
# For local development: http://localhost:11434
# For cloud deployment: https://api.ollama.cloud or your self-hosted instance
OLLAMA_HOST=http://localhost:11434
# OLLAMA_API_KEY=your_api_key_here  # Required for cloud, optional for local
OLLAMA_MODEL=qwen3.5:4b

# --- ITR Service Configuration ---
# URL of the Python tax microservice (india-itr-copilot wrapper)
ITR_SERVICE_HOST=http://localhost:8000
