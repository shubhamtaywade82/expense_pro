# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore assets built by jsbundling/cssbundling.
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore the Vite build of frontend/ (see frontend/vite.config.ts outDir).
/public/frontend

# Node
node_modules/
.npm
.yarn/
npm-debug.log*
yarn-error.log*

# Python (itr_service)
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / tooling
.ruby-lsp/
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Root uses yarn (Dockerfile, bin/setup, Procfile); frontend/ uses npm.
/package-lock.json
bun.lock
