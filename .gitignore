# Logs
/log/*
!/log/.keep
*.log

# Temp files
/tmp/*
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep

# Storage (uploaded files in development)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Environment
/.env*
!/.env.example

# Secrets
/config/master.key

# Credentials
*.pem
*.key
*.p12

# Assets built with esbuild/jsbundling
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
.mypy_cache/
.pytest_cache/

# Build artifacts
dist/
build/
target/
*.pyc
*.class
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Editors
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Temp
*.swp
*.tmp
